import math
PI= math.pi

def circlr_area(r):
    return(PI*r*r)

def circlr_perimeter(r):
    return(2*r*PI)

def rec_area(l,b):
    return(l*b)

def rec_perimeter(l,b):
    return(2*(l+b))

def sq_area(l):
    return(l*l)

def sq_perimeter(l):
    return(4*l)

polygon=''
